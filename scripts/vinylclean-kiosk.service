[Unit]
Description=vinylclean — full-screen control page on the touchscreen
After=vinylclean-live.service systemd-user-sessions.service
Wants=vinylclean-live.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# The screen comes AFTER the sound: low priority, the real-time audio thread is never disturbed.
Nice=15
CPUWeight=20
IOWeight=20
# Wait until the page answers (up to 30 s).
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do (exec 3<>/dev/tcp/127.0.0.1/8080) 2>/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=@KIOSK@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
