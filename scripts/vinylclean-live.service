[Unit]
Description=vinylclean — real-time vinyl cleaning (vc-live)
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=@USER@
Group=audio
SupplementaryGroups=audio
Environment=HOME=@HOME@
LimitRTPRIO=95
LimitMEMLOCK=infinity
EnvironmentFile=-/etc/default/vinylclean
# Fixed CPU frequency: no speed changes while listening.
ExecStartPre=+/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g"; done'
# Wait for the USB sound card (up to 30 s after boot).
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /proc/asound/card0 ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/bin/vc-live --quiet $VC_OPTS
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
